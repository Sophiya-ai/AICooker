# Обязательные секреты. Скопируйте файл в .env и замените примеры.
TELEGRAM_BOT_TOKEN=1234567890:replace_with_token_from_botfather
OPENAI_API_KEY=sk-replace_with_your_openai_key

# Модели можно заменить на доступные вашему аккаунту совместимые модели.
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# Локальный сервер статических файлов Mini App. Для режима ngrok оставьте
# 127.0.0.1: внешний доступ к порту предоставляет сам туннель.
WEBAPP_HOST=127.0.0.1
WEBAPP_PORT=8080
WEBAPP_STATIC_DIR=miniapp

# ЛОКАЛЬНЫЙ РЕЖИМ: true запускает ngrok автоматически вместе с bot.py.
# Зарегистрируйтесь на ngrok.com и скопируйте authtoken из личного кабинета.
ENABLE_NGROK=true
NGROK_AUTHTOKEN=replace_with_your_ngrok_authtoken

# СЕРВЕРНЫЙ РЕЖИМ: установите ENABLE_NGROK=false и укажите постоянный HTTPS URL.
# При локальном автоматическом ngrok это поле можно оставить пустым.
WEBAPP_URL=

# Путь к SQLite. Относительный путь разрешается от текущей рабочей папки,
# поэтому для предсказуемости можно оставить значение пустым и использовать default.
DATABASE_PATH=recipes.db
